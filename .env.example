# RapidAPI — Semrush Keyword Magic Tool + Google Keyword Insight
RAPIDAPI_KEY=

# OpenRouter — LLM synthesis (Llama 3.3 70B, Nemotron 49B)
OPENROUTER_API_KEY=

# Google PageSpeed Insights
PAGESPEED_API_KEY=

# Postgres — required for LangGraph worker (graph/ layer)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Optional: GitHub token for Vite SPA audit (higher rate limit)
GITHUB_TOKEN=
